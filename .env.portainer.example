# Variables for the Portainer stack (docker-compose.portainer.yml).
# Paste these into the stack's "Environment variables" section (or upload this file there) and fill in the values.

# Public URL that NPMplus serves the app on (used in emails and links).
APP_URL=https://learning.example.org

# Long random string, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=

# Postgres credentials (shared by the db, app and backup containers).
POSTGRES_USER=ypo
POSTGRES_PASSWORD=
POSTGRES_DB=ypo
BACKUP_KEEP_DAYS=14

# Outgoing mail. Office 365: smtp.office365.com, port 587, SMTP_SECURE=false, an app password, and EMAIL_FROM matching the mailbox.
EMAIL_FROM="YPO SEA Learning <admin@example.org>"
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# First super administrator, created by running the seed once (see README).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# Port published on this Docker host for NPMplus (on another host) to forward to.
# APP_BIND=0.0.0.0 listens on all interfaces; set it to this host's LAN IP to listen on that interface only.
APP_PORT=3000
APP_BIND=0.0.0.0
