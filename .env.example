# App
APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
# Database (compose overrides this for the app container)
DATABASE_URL=postgresql://ypo:ypo@localhost:5432/ypo?schema=public
# Email. Local dev defaults to the Mailpit container (no auth, inbox at http://localhost:8025).
# To send real mail from local dev, point these at your provider (Office 365: smtp.office365.com, port 587, SMTP_SECURE=false).
EMAIL_FROM="YPO SEA Learning <no-reply@example.com>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Production with Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<api key> SMTP_SECURE=true
# Seed super admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin
