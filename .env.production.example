# Copy to .env on the production server and fill in every value.

# Public URL and the domain Caddy should obtain a certificate for.
DOMAIN=learning.example.org
APP_URL=https://learning.example.org

# Long random string, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=

# Postgres (used by the db, app and backup containers).
POSTGRES_USER=ypo
POSTGRES_PASSWORD=
POSTGRES_DB=ypo
BACKUP_KEEP_DAYS=14

# Email via Resend over SMTP (or any SMTP provider).
EMAIL_FROM="YPO SEA Learning <no-reply@learning.example.org>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SECURE=true

# First super administrator, created by `make prod-seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
